# Puerto de la API
PORT=4000

# Base de datos.
# - Vacío: usa PGlite (PostgreSQL embebido) guardado en apps/api/.data/pglite. Ideal para la demo local.
# - Con valor: PostgreSQL real (por ejemplo Neon). Ej: postgresql://usuario:clave@host/neondb?sslmode=require
DATABASE_URL=

# Secreto para firmar sesiones. OBLIGATORIO en producción (usa una cadena larga y aleatoria).
JWT_SECRET=

# Origen permitido del frontend (solo si NO usas el proxy /api de Vercel). Ej: https://tu-app.vercel.app
CORS_ORIGIN=

# Contraseña de las cuentas demo que crea el seed (si no se define, se usa Demo2026*)
DEMO_PASSWORD=

# Cargar datos demo automáticamente si la base está vacía (true/false)
AUTO_SEED=true

# Saltos de proxy de confianza para conocer la IP real (1 = solo Render, 2 = Vercel + Render)
TRUST_PROXY=1
